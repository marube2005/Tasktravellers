# Client-safe runtime values consumed via:
# flutter run --dart-define-from-file=.env

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional non-secret app settings
PAYHERO_CHANNEL_ID=0
PAYHERO_CALLBACK_URL=https://your-backend-or-edge-callback

# Never put these in Flutter client env files:
# SUPABASE_SERVICE_ROLE_KEY
# PAYHERO_API_PASSWORD
# PAYHERO_API_BASIC_AUTH_TOKEN
